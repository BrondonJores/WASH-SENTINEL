# WASH Sentinel AI Engine — variables d'environnement (lots 1-5 + opérationnel).
# Copier vers .env et ajuster. Chaque variable est optionnelle : le défaut
# indiqué est la valeur historique utilisée quand la variable est absente ou
# invalide. LOTS 1-5 anti-valeurs-en-dur : une seule valeur par réglage.
#
# Conventions : décimaux avec point (0.80), listes séparées par des virgules
# sans espaces (1.0,2.0,4.0), JSON compact sur une ligne pour les tables.

# ============ LOT 1 — doublons / routage / normalisation texte ============
# Seuils cosinus doublons (thresholds.py).
DUPLICATE_DECISION_THRESHOLD=0.80
DUPLICATE_MATCH_CUTOFF=0.70
DUPLICATE_JACCARD_FALLBACK=0.25
# Routage d'intention (router.py).
ROUTER_MARGIN_MIN=0.15
ROUTER_CREATE_MIN_SCORE=1.0
ROUTER_DATA_MIN_SCORE=1.0
ROUTER_PLUGIN_FEATURE_WEIGHT=2.0
# Normalisation texte / lieux (textnorm.py).
TEXTNORM_NEGATION_WINDOW=3
TEXTNORM_NEGATION_NE_WINDOW=5
TEXTNORM_DISTRICT_MIN_LEN=4
TEXTNORM_PLACE_CUTOFF=0.75

# ============ LOT 2 — extraction / schémas / pont bbj ============
# (Aucune ENV : constantes pures — poids priorité, tables urgence/risque,
# bornes SCORE_MIN/SCORE_MAX, RAG_K_DEFAULT, voix TTS, timeouts de test.)

# ============ LOT 3 — décision / épidémie / équité / récurrence ============
# Arbitrage réparer/remplacer (decision_agent.py).
DECISION_REPLACE_MIN_RATIO_PCT=55.0
DECISION_REPLACE_MIN_INCIDENTS=4
DECISION_REPLACE_MIN_DAYS_OFF=30
DECISION_REPAIR_SAVING_RATIO=0.45
DECISION_SAVING_HORIZON_MONTHS=24
DECISION_MONITOR_MIN_RATIO_PCT=30.0
DECISION_MONITOR_MIN_INCIDENTS=2
# Détection de grappes épidémiques (epidemic_detector.py).
EPIDEMIC_CLUSTER_WINDOW_DAYS=7
EPIDEMIC_OUTBREAK_MIN_STRONG_SCHOOLS=3
EPIDEMIC_HIGH_MIN_STRONG_SCHOOLS=2
EPIDEMIC_MODERATE_MIN_SCHOOLS=1
# Équité territoriale + tournées (equity_dispatcher.py).
EQUITY_WATER_NORM_DAYS=20.0
EQUITY_URGENCY_LOW=15.0
EQUITY_URGENCY_MEDIUM=45.0
EQUITY_URGENCY_HIGH=75.0
EQUITY_URGENCY_CRITICAL=100.0
EQUITY_FEMALE_RATIO_MIN=0.3
EQUITY_FEMALE_RATIO_MAX=0.7
EQUITY_LATRINE_NORM_COUNT=4.0
EQUITY_LATRINE_BASELINE_SCORE=0.1
EQUITY_GENDER_AMPLIFIER=1.5
EQUITY_DISTANCE_NORM_KM=70.0
EQUITY_DISTANCE_MAX_POINTS=50.0
EQUITY_ABANDON_NORM_MONTHS=18.0
EQUITY_ABANDON_MAX_POINTS=50.0
EQUITY_WEIGHT_WATER=0.30
EQUITY_WEIGHT_URGENCY=0.25
EQUITY_WEIGHT_GENDER=0.25
EQUITY_WEIGHT_ISOLATION=0.20
EQUITY_REASON_MIN_DAYS_WITHOUT_WATER=10
EQUITY_REASON_MIN_BROKEN_TOILETS=2
EQUITY_REASON_MIN_ISOLATION_KM=40
EQUITY_ROUTE_MAX_DIST_DIFF_KM=18.0
EQUITY_ROUTE_SAVED_KM_FACTOR=1.6
EQUITY_ROUTE_MAX_PIGGYBACK=2
EQUITY_TRANSPARENCY_NOTE_MIN_CHARS=100
# Veille récidives (recurrence_watch.py).
RECURRENCE_WINDOW_DAYS=90
RECURRENCE_HIGH_SAME_TYPE_COUNT=3
RECURRENCE_WATCH_SAME_TYPE_COUNT=2
RECURRENCE_MEAN_INTERVAL_ALERT_DAYS=30.0
RECURRENCE_AGGREGATE_HIGH_INCIDENT_COUNT=4
RECURRENCE_AGGREGATE_WATCH_INCIDENT_COUNT=2
RECURRENCE_AGGREGATE_CRITICAL_DAYS_OFF=30

# ============ LOT 4 — boucle agent / outils ============
# Budgets et fenêtres de la boucle agentique (agent_loop.py).
AGENT_MAX_ITERATIONS=5
AGENT_RUN_BUDGET_S=100.0
AGENT_MAX_LLM_CALLS=6
AGENT_HISTORY_TURNS=6
AGENT_HISTORY_TURN_MAX_CHARS=1200
AGENT_HISTORY_MAX_CHARS=4000
AGENT_OBS_LIST_MAX_ITEMS=12
AGENT_OBS_STR_MAX_CHARS=2000
AGENT_LANG_MIN_HITS=2
AGENT_LANG_MIN_TOKENS=4
# Limites d'affichage des outils (agent_tools.py).
AGENT_TOOLS_HEATMAP_WINDOW_DAYS=90
AGENT_TOOLS_SCHOOL_CHOICES_LIMIT=10
AGENT_TOOLS_INCIDENT_CHOICES_LIMIT=5
AGENT_TOOLS_BUDGET_COMPARE_TOP=5
AGENT_TOOLS_TRENDS_PER_SCHOOL_TOP=5
AGENT_TOOLS_MAINTENANCE_LOGS_LIMIT=10
AGENT_TOOLS_MAINTENANCE_LOGS_MIN=1
AGENT_TOOLS_MAINTENANCE_LOGS_MAX=50
AGENT_TOOLS_TREND_RATIO_THRESHOLD=0.15

# ============ LOT 5 — voix / vision / robustesse LLM ============
# Retry exponentiel borné + warmup + embeddings (providers.py).
LLM_RETRY_MAX_ATTEMPTS=3
LLM_RETRY_BACKOFF_SECONDS=1.0,2.0,4.0
LLM_RETRYABLE_STATUS_CODES=408,429,500,502,503,504
LLM_WARMUP_TIMEOUT=15.0
LLM_EMBED_CONCURRENCY=4
# Provider LLM par défaut (providers.py ; surchargeable par requête via X-LLM-*).
LLM_PROVIDER=ollama
# Ollama local (défauts partagés code + UI Settings).
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
# Défaut vision UNIQUE lots/provider+analyseur (grosses machines : llama3.2-vision:11b).
OLLAMA_VISION_MODEL=moondream
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=120.0
# API compatible-OpenAI (vide = Ollama seul ; vision vide = même modèle texte).
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_API_KEY=
OPENAI_TIMEOUT=120.0
# Moteurs STT (stt_providers.py ; X-STT-* par requête, STT_DRIVER par défaut).
STT_DRIVER=whisper_cpp
VOICE_STT_BINARY=/opt/voice/bin/whisper-cli
VOICE_STT_MODEL=/models/whisper/ggml-base.bin
VOICE_STT_PROMPT=
OMNI_STT_MODEL=/models/omnilingual/model.int8.onnx
OMNI_STT_TOKENS=/models/omnilingual/tokens.txt
CLOUD_STT_BASE_URL=https://api.openai.com/v1
CLOUD_STT_MODEL=whisper-1
CLOUD_STT_API_KEY=
# Driver Omnilingual CTC ghomala' (stt_omnilingual.py).
OMNI_CTC_MODEL=/models/omnilingual/model.int8.onnx
OMNI_CTC_TOKENS=/models/omnilingual/tokens.txt
OMNI_CTC_HF_MODEL=facebook/omniASR-CTC-300M
OMNI_CTC_ONNX_REPO=csukuangfj/sherpa-onnx-omnilingual-asr-1600-languages-300M-ctc-int8-2025-11-12
# Moteurs TTS (tts_providers.py / voice_service.py).
TTS_DRIVER=piper
VOICE_TTS_BINARY=/opt/voice/bin/piper
VOICE_TTS_MODEL=/models/piper/fr_FR-upmc-medium.onnx
MMS_TTS_MODEL_DIR=/models/mms-tts
MMS_TTS_CACHE_DIR=/tmp/wash-mms-tts
# Registre voix JSON {"lang": ["voix", ...]} (étend BUILTIN_VOICE_REGISTRY).
VOICE_REGISTRY_JSON=
# RAG documentaire (rag_store.py).
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=3
RAG_MIN_SIMILARITY=0.30
# Observabilité IA (ai_metrics.py ; JSON compact pour les tarifs).
AI_METRICS_MAX_ENTRIES=500
AI_METRICS_COSTS_JSON=
