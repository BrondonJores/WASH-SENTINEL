# --- Ports exposés ---
APP_PORT=80
FRONTEND_PORT=5173
FORWARD_DB_PORT=5432
FORWARD_AI_PORT=8000
FORWARD_OLLAMA_PORT=11435

# --- URL API vue par le navigateur (adapter si APP_PORT change) ---
VITE_API_URL=http://localhost/api

# --- PostgreSQL ---
DB_DATABASE=wash_sentinel
DB_USERNAME=sentinel_user
DB_PASSWORD=secret_sentinel

# --- Moteur IA ---
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_VISION_MODEL=llama3.2-vision:11b
OLLAMA_EMBED_MODEL=nomic-embed-text
STT_DRIVER=whisper_cpp
